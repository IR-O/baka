# ==========================================
# MIKO / RADHA TELEGRAM BOT ENVIRONMENT CONFIGURATION
# ==========================================

# Telegram Bot Token from @BotFather (Required)
BOT_TOKEN=your_bot_token_here

# Bot Owner Telegram User ID (Required for SuperAdmin commands)
OWNER_ID=7408854697

# Optional: Dedicated Telegram Group ID for System/Activity/Deposit Logs
LOG_GROUP_ID=-1001234567890

# OpenRouter AI API Key for Chatbot & AI Gaming Assistant
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Preferred OpenRouter AI Model (Optional, defaults to free fallback pool)
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Razorpay Standard Checkout & Webhooks (For Premium / In-game coin purchases)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# SQLite Database Storage Path (Defaults to radha_data.db in root)
SQLITE_DB_PATH=radha_data.db

# Payment Webhook Server Port (Optional, default: 8080)
PORT=8080
